# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection used by the API and the ingestion jobs.
DATABASE_URL=postgresql+psycopg://milanko_develop_app:change-me@127.0.0.1:5432/milanko_develop

# Optional NASA credentials. POWER and EONET work without a key; FIRMS and
# Earthdata may require their own credentials for future ingestion jobs.
NASA_API_KEY=
FIRMS_MAP_KEY=
EARTHDATA_TOKEN=
