[Unit]
Description=Milanko NASA ingest (%i)
Documentation=https://github.com/hexalis/milanko-backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/milanko-ingest %i
Environment=MILANKO_ENV=develop
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
